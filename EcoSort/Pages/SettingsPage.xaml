<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EcoSort.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel MaxWidth="900" Margin="24" Spacing="12">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Configuration options will be added as app capabilities grow." Style="{StaticResource BodyStrongTextBlockStyle}" />

            <Border Padding="16" CornerRadius="12" BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="Experimental Features" Style="{StaticResource SubtitleTextBlockStyle}" />

                    <ToggleSwitch x:Name="LiveInferenceToggle"
                                  Header="Enable Live Inference (Experimental)"
                                  Toggled="LiveInferenceToggle_Toggled" />

                    <InfoBar IsOpen="True"
                             IsClosable="False"
                             Severity="Warning"
                             Message="Live inference is experimental and processes a continuous camera feed with real-time object detection. This feature uses continuous frame processing with frame throttling to maintain responsiveness. Results may be unstable while this feature is in active development." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
