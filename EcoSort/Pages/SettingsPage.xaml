<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EcoSort.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel MaxWidth="900" Margin="24" Spacing="12">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Configuration options will be added as app capabilities grow." Style="{StaticResource BodyStrongTextBlockStyle}" />
        </StackPanel>
    </ScrollViewer>
</Page>
