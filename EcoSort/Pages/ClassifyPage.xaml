<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EcoSort.Pages.ClassifyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <Grid MaxWidth="900" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="8">
                <TextBlock Text="Classify Item" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Upload an image to get category and disposal guidance." Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="EcoSort supports a fixed set of 12 trained categories." TextWrapping="WrapWholeWords" />
                <InfoBar x:Name="ExperimentalLiveInferenceInfoBar"
                         IsOpen="False"
                         IsClosable="False"
                         Severity="Warning"
                         Message="Experimental live inference mode is enabled in Settings. Results may be unstable while this feature is in active development." />
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,20,0,0">
                <Button x:Name="ClassifyButton"
                        Content="Classify Item"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="ClassifyButton_Click" />
                <Button x:Name="StartCameraButton"
                        Content="Start Camera"
                        Click="StartCameraButton_Click" />
                <Button x:Name="SnapPhotoButton"
                        Content="Snap Photo"
                        Click="SnapPhotoButton_Click"
                        Visibility="Collapsed" />
                <Button x:Name="StopCameraButton"
                        Content="Stop Camera"
                        Click="StopCameraButton_Click"
                        Visibility="Collapsed" />
                <ProgressRing x:Name="InferenceProgressRing" Width="22" Height="22" IsActive="False" Visibility="Collapsed" />
            </StackPanel>

            <Border x:Name="DropTargetBorder"
                    Grid.Row="2"
                    Margin="0,20,0,0"
                    CornerRadius="12"
                    BorderThickness="1"
                    Padding="12"
                    MinHeight="320"
                    AllowDrop="True"
                    DragOver="DropTargetBorder_DragOver"
                    DragLeave="DropTargetBorder_DragLeave"
                    Drop="DropTargetBorder_Drop">
                <Grid>
                    <Rectangle x:Name="DropHoverBorder"
                               RadiusX="12"
                               RadiusY="12"
                               Stroke="ForestGreen"
                               StrokeThickness="2"
                               StrokeDashArray="4,3"
                               Visibility="Collapsed" />

                    <StackPanel Spacing="8" Margin="8">
                        <Grid x:Name="CameraContainer" HorizontalAlignment="Center">
                            <MediaPlayerElement x:Name="CameraPreviewElement"
                                                Width="640"
                                                Height="360"
                                                HorizontalAlignment="Center"
                                                Stretch="UniformToFill"
                                                AreTransportControlsEnabled="False"
                                                AutoPlay="True"
                                                Visibility="Collapsed" />
                            <Canvas x:Name="DetectionOverlayCanvas"
                                    Width="640"
                                    Height="360"
                                    HorizontalAlignment="Center"
                                    Background="Transparent"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed" />
                        </Grid>
                        <Image x:Name="PreviewImage"
                               MaxHeight="300"
                               Stretch="Uniform"
                               HorizontalAlignment="Stretch" />
                        <TextBlock x:Name="DropHintText"
                                   Text="Drag and drop an image here (.jpg, .jpeg, .png), or use Classify Item."
                                   Opacity="0.8"
                                   TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="3" Margin="0,20,0,0" CornerRadius="12" BorderThickness="1" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Classification Result" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="ResultCategoryText" Text="Category: —" TextWrapping="WrapWholeWords" />
                    <TextBlock x:Name="ResultConfidenceText" Text="Confidence: —" TextWrapping="WrapWholeWords" />
                    <TextBlock x:Name="ResultExplanationText" Text="Explanation: —" TextWrapping="WrapWholeWords" />
                    <TextBlock x:Name="ResultGuidanceText" Text="Disposal guidance: —" TextWrapping="WrapWholeWords" />
                    <InfoBar x:Name="LowConfidenceInfoBar"
                             Severity="Informational"
                             IsClosable="False"
                             IsOpen="False"
                             Message="This item may not match the categories the model was trained on. Use your judgment or explore the educational hub for guidance." />
                    <TextBlock x:Name="ResultErrorText" Foreground="IndianRed" TextWrapping="WrapWholeWords" Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
