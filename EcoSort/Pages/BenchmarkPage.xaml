<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EcoSort.Pages.BenchmarkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <Grid MaxWidth="900" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="8">
                <TextBlock Text="Model Benchmarking" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Test ResNet50 model performance and measure latency." Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="Select a folder containing images to benchmark the model's inference speed." TextWrapping="WrapWholeWords" />
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,20,0,0">
                <Button x:Name="SelectFolderButton"
                        Content="Select Folder to Benchmark"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="SelectFolderButton_Click" />
                <ProgressRing x:Name="BenchmarkProgressRing" Width="22" Height="22" IsActive="False" Visibility="Collapsed" />
            </StackPanel>

            <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,16,0,0" Text="Ready to benchmark" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords" />

            <InfoBar x:Name="ResultsInfoBar"
                     Grid.Row="2"
                     Margin="0,16,0,0"
                     IsOpen="False"
                     IsClosable="True"
                     Severity="Success"
                     Message="Benchmark completed successfully." />

            <InfoBar x:Name="ErrorInfoBar"
                     Grid.Row="2"
                     Margin="0,16,0,0"
                     IsOpen="False"
                     IsClosable="True"
                     Severity="Error" />

            <Border Grid.Row="3" Margin="0,20,0,0" CornerRadius="12" BorderThickness="1" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Results" Style="{StaticResource SubtitleTextBlockStyle}" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="Images Processed" Style="{StaticResource BodyStrongTextBlockStyle}" Opacity="0.8" />
                        <TextBlock x:Name="ImageCountText" Text="—" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Average Latency" Style="{StaticResource BodyStrongTextBlockStyle}" Opacity="0.8" />
                        <TextBlock x:Name="AverageLatencyText" Text="—" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Minimum Latency" Style="{StaticResource BodyStrongTextBlockStyle}" Opacity="0.8" />
                        <TextBlock x:Name="MinLatencyText" Text="—" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Maximum Latency" Style="{StaticResource BodyStrongTextBlockStyle}" Opacity="0.8" />
                        <TextBlock x:Name="MaxLatencyText" Text="—" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Total Latency" Style="{StaticResource BodyStrongTextBlockStyle}" Opacity="0.8" />
                        <TextBlock x:Name="TotalLatencyText" Text="—" />
                    </StackPanel>

                    <Expander Margin="0,12,0,0">
                        <Expander.Header>
                            <TextBlock Text="Processed Images" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </Expander.Header>
                        <ListBox x:Name="ProcessedImagesListBox"
                                 MaxHeight="200"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ItemsSource="{x:Bind ProcessedImages, Mode=OneWay}" />
                    </Expander>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
